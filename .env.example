# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string of the Neon branch (dev locally, main in production).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) URL, used by drizzle-kit for migrations. Optional.
DATABASE_URL_UNPOOLED=
# Local alternative: `docker compose up -d` then
# DATABASE_URL=postgres://furbo:furbo@localhost:5442/furbo

# --- Auth (Better Auth) ------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (http://localhost:3000 in dev).
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ----------------------------------------------------------
# Without a key, emails (magic links, password resets) are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Furbo <onboarding@resend.dev>"

# --- Cron ----------------------------------------------------------------------
# Vercel sends it as "Authorization: Bearer …" to /api/cron/cerrar-partidos.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Geocoding (Nominatim / OpenStreetMap) --------------------------------------
# OSM policy asks for an identifying User-Agent, ideally with a contact URL or email.
NOMINATIM_USER_AGENT="Furbo/0.1"
